{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>zwave-js/renovate-config:app",
    "github>zwave-js/renovate-config:zwave-js-consumer"
  ],
  // The *.lock.yml files and agentics-maintenance.yml are generated by gh aw compile.
  // Their action pins come from .github/aw/actions-lock.json and change with gh-aw upgrades.
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    ".github/workflows/*.lock.yml",
    ".github/workflows/agentics-maintenance.yml",
    ".github/workflows/codeql-analysis.yml"
  ],
  "rollbackPrs": true,
  "customManagers": [
    {
      // gh-aw is installed by version pin in several workflows. Bumping the pin regenerates
      // all compiled workflows, which gh-aw-renovate-recompile.yml does on the PR.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["gh extension install github/gh-aw --pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github/gh-aw",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      // Raise together with engines.node
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<21"
    },
    {
      // zwave-js is bumped by update-dep.yml, dispatched by the zwave-js-assistant bot on each release
      "matchPackageNames": ["zwave-js"],
      "enabled": false
    },
    {
      // Base images stay pinned to a digest
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      // docker/Dockerfile stands node's binaries on a bare alpine base, so both images
      // must be on the same Alpine release - the apk packages (openssl, libusb, eudev)
      // have to match what the node binary was linked against. Keep the two in one PR.
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["node", "alpine"],
      "groupName": "docker base images"
    },
    {
      // Docker versioning keeps the tag suffix fixed, so node only ever moves
      // 22.x-alpine3.22 -> 22.y-alpine3.22; it can't tell whether the alpine bump has a
      // matching node tag (node:22.20.0-alpine3.24 does not exist - Alpine variants are
      // only published for the newest patch of a line). Alpine minors therefore need a
      // human to move the ALPINE_IMAGE and the NODE_IMAGE suffix together. Digest pins
      // and node patch updates stay automatic.
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["alpine"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      // All gh-aw pins move in one PR so the recompiled workflows match
      "matchDepNames": ["github/gh-aw"],
      "groupName": "gh-aw",
      "automerge": false
    }
  ]
}
